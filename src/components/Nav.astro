---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-badge.png';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const links = [
  { href: '#work', label: 'Work' },
  { href: '#code', label: 'Code' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav" data-nav>
  <div class="nav__inner shell">
    <a class="nav__mark" href="#top" aria-label={`${site.name} — home`}>
      {/* alt is empty on purpose — the anchor above is already labelled, so
          alt text here would announce the destination twice. */}
      <Image
        class="nav__mark-logo"
        src={logoMark}
        alt=""
        width={78}
        height={78}
        densities={[1, 2]}
        loading="eager"
      />
      <span class="nav__mark-text">{site.handle}</span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {
        links.map((link) => (
          <a class="nav__link" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    {/* Grouped so the toggle stays visible below 720px, where .nav__links
        hides and the bar collapses to mark + actions. */}
    <div class="nav__actions">
      <ThemeToggle />

      <a class="nav__cta" href={site.social.github} target="_blank" rel="noopener noreferrer">
        GitHub
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Solidify the bar once the hero is behind it, and get out of the way when
  // the reader is scrolling down so the full viewport belongs to the content.
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (nav) {
    let last = window.scrollY;

    const update = () => {
      const y = window.scrollY;
      nav.classList.toggle('is-solid', y > 80);
      nav.classList.toggle('is-hidden', y > 400 && y > last);
      last = y;
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition:
      transform 0.5s var(--ease),
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease),
      backdrop-filter 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .nav.is-solid {
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }

  .nav.is-hidden {
    transform: translateY(-100%);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.05rem;
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: lowercase;
  }

  .nav__mark-logo {
    /* 39px, not 30px: the badge's peach fills only 77.5% of its frame, so it is
       scaled up to hold the squid at the size it had as a bare disc — the white
       rim is added around it rather than eating into it. */
    width: 39px;
    height: 39px;
    border-radius: 50%;
    flex: none;
    /* The source is already a clean circle; the radius is belt-and-braces
       against any stray edge pixel from the crop. */
    transition: transform 0.45s var(--ease);
  }

  /* Replaces the dot's idle pulse. An abstract dot could throb and read as
     "live"; an illustration doing the same just reads as cheap, so the motion
     is now a response to the reader rather than unprompted. */
  .nav__mark:hover .nav__mark-logo {
    transform: scale(1.06) rotate(-4deg);
  }

  .nav__links {
    display: none;
    gap: clamp(1.25rem, 3vw, 2.75rem);
  }

  @media (min-width: 720px) {
    .nav__links {
      display: flex;
    }
  }

  .nav__link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding-block: 0.25rem;
    transition: color 0.3s var(--ease);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }

  .nav__link:hover {
    color: var(--text);
  }

  .nav__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    color: var(--text);
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  .nav__cta:hover {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav.is-hidden {
      transform: none;
    }

    .nav__mark:hover .nav__mark-logo {
      transform: none;
    }
  }
</style>
