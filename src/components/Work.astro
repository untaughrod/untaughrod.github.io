---
import { Image } from 'astro:assets';
import Carousel from './Carousel.astro';
import { work, disciplineLabels } from '../data/work';

/**
 * Shared card height. Every width falls out of this via each image's own
 * aspect ratio, so nothing is cropped and the strip still reads as a filmstrip.
 *
 * 430 is set by the source material rather than taste: the illustrations are
 * 1080px tall Instagram exports, so a taller card would be visibly soft on a
 * high-density screen.
 */
const CARD_HEIGHT = 430;
---

<section class="work" id="work">
  <div class="work__intro shell">
    <p class="eyebrow" data-reveal>Ten years before the code</p>
    <h2 class="work__title" data-split>The craft</h2>
    <p class="lede" data-reveal>
      Illustration taught me silhouette and weight. 3D taught me tolerance and
      how a part is actually made. Product design taught me to defend a
      decision. All of it shows up in the software.
    </p>
  </div>

  <Carousel label="Selected illustration and 3D work">
    {
      work.map((item) => (
        <article class="piece" style={`--ratio: ${item.image.width} / ${item.image.height}`}>
          <div class="piece__frame">
            <Image
              class="piece__image"
              src={item.image}
              alt={item.title}
              width={Math.round(CARD_HEIGHT * item.ratio)}
              height={CARD_HEIGHT}
              densities={[1, 2]}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="piece__body">
            <h3 class="piece__title">{item.title}</h3>
            <p class="piece__meta">
              <span>{disciplineLabels[item.discipline]}</span>
              {item.year && (
                <>
                  <span class="piece__dot" aria-hidden="true">
                    ·
                  </span>
                  <span>{item.year}</span>
                </>
              )}
            </p>
          </div>
        </article>
      ))
    }
  </Carousel>
</section>

<style>
  .work {
    position: relative;
    /* Asymmetric on purpose. The marquee that follows reads as the next
       section starting, so it does not need holding far off; a symmetric
       bottom left 176px of dead band under the pause control. */
    padding-block: clamp(5rem, 3rem + 10vw, 12rem) clamp(2.5rem, 1.5rem + 2.5vw, 4.5rem);
    background: var(--surface-sunken);
  }

  .work__intro {
    display: grid;
    gap: 1.5rem;
    max-width: 70ch;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .work__title {
    font-size: var(--step-4);
  }

  .piece {
    flex: none;
    display: grid;
    gap: 0.9rem;
  }

  /*
   * Height is the fixed dimension; width follows from the image's own ratio.
   * Doing it this way means no JavaScript measurement, no cropping, and no
   * layout shift — the box is the right size before the image arrives.
   */
  .piece__frame {
    height: clamp(240px, 42vh, 430px);
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--surface-raised);
    border: 1px solid var(--line);
  }

  .piece__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .piece:hover .piece__image {
    transform: scale(1.04);
  }

  .piece__body {
    display: grid;
    gap: 0.3rem;
    /* Keeps a long title from stretching a narrow card. */
    max-width: 34ch;
  }

  .piece__title {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }

  .piece__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .piece__dot {
    color: var(--text-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .piece:hover .piece__image {
      transform: none;
    }
  }
</style>
